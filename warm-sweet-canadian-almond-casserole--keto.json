    },
    {
      "name": "Granulated sweetener",
      "amount": "1/2 cup",
      "notes": "such as Swerve or Erythritol"
    },
    {
      "name": "Unsalted butter",
      "amount": "1/2 cup",
      "notes": "softened"
    },
    {
      "name": "Large eggs",
      "amount": "3",
      "notes": "room temperature"
    },
    {
      "name": "Sweetened vanilla extract",
      "amount": "1 teaspoon",
      "notes": "make sure it's sugar-free"
    },
    {
      "name": "Chopped almonds",
      "amount": "1/2 cup",
      "notes": "for garnish"
    },
    {
      "name": "Sweetener for topping",
      "amount": "2 tablespoons",
      "notes": "such as powdered sweetener"
    }
  ],
  "instructions": [
    "Preheat oven to 350°F (175°C).",
    "In a large mixing bowl, combine almond flour, granulated sweetener, and unsalted butter. Mix well.",
    "Beat in eggs and sweetened vanilla extract. Mix until smooth.",
    "Pour the mixture into a 9x9 inch baking dish.",
    "Bake for 25-30 minutes or until the edges are lightly golden brown.",
    "Remove from oven and sprinkle chopped almonds on top.",
    "Return to oven and bake for an additional 5-7 minutes.",
    "Let cool for 10 minutes before serving.",
    "Dust with powdered sweetener if desired."
