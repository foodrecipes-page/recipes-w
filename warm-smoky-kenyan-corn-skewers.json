    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "for serving"
    },
    {
      "name": "chopped fresh cilantro",
      "amount": "1/4 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat.",
    "Thread 2-3 corn slices onto each skewer, leaving a little space between each piece.",
    "In a small bowl, mix together olive oil, warm spices, salt, and black pepper.",
    "Brush the skewers with the spice mixture, making sure to coat all surfaces.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until slightly charred.",
    "Remove from heat and brush with lemon juice.",
    "Garnish with chopped cilantro and serve immediately."
