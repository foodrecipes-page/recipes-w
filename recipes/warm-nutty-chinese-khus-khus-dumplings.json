{
  "title": "Warm Nutty Chinese Khus Khus Dumplings",
  "description": "A nutty and crisp Chinese dish featuring khus khus, perfect for midnight cravings, with a fermentation process that makes it FODMAP-friendly.",
  "cuisine": "Chinese",
  "diet": [
    "vegetarian"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "khus khus",
      "amount": "1 cup",
      "notes": "also known as poppy seeds"
    },
    {
      "name": "rice flour",
      "amount": "2 cups"
    },
    {
      "name": "water",
      "amount": "1 cup"
    },
    {
      "name": "sesame oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "active dry yeast",
      "amount": "1 teaspoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "In a large mixing bowl, combine rice flour, khus khus, salt, sugar, and yeast.",
    "Gradually add in water and mix until a dough forms.",
    "Knead the dough for 10 minutes until it becomes smooth and elastic.",
    "Cover the dough with a damp cloth and let it ferment in a warm place for 2 hours.",
    "Divide the dough into small balls and flatten each ball into a disk shape.",
    "Heat sesame oil in a large skillet over medium heat.",
    "Pan-fry the dumplings until they are golden brown and crispy.",
    "Serve warm and garnish with chopped scallions."
  ],
