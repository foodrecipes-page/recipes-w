      "notes": "shio-cure for 2 hours"
    },
    {
      "name": "basmati rice",
      "amount": "2 cups",
      "notes": "soaked for 30 minutes"
    },
    {
      "name": "chilled butter",
      "amount": "1/2 cup",
      "notes": "cut into small pieces"
    },
    {
      "name": "onions",
      "amount": "1 large",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "cumin seeds",
      "amount": "1 teaspoon",
      "notes": "toasted"
    },
    {
      "name": "coriander powder",
      "amount": "1 teaspoon",
      "notes": "ayurvedic-tamasic-friendly"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Heat a large pan over medium heat and toast the cumin seeds for 1 minute.",
    "Add the sliced onions and cook until they are lightly browned.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the soaked basmati rice and cook for 2 minutes.",
    "Add 2 cups of water and bring to a boil.",
    "Reduce the heat to low and cover the pan with a tight-fitting lid.",
    "Simmer for 15 minutes or until the rice is cooked and fluffy.",
    "While the rice is cooking, grill the shio-cure cod fillets for 4 minutes per side.",
    "Flake the cooked cod into large pieces and add to the cooked rice.",
    "Stir in the chilled butter and coriander powder.",
    "Season with salt to taste.",
    "Serve the biryani in a bento-box."
  ],
