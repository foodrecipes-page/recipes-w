    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "chicken broth",
      "amount": "4 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the peanut butter in a large pot over medium heat until melted and smooth.",
    "Add the smoked paprika, onion, and garlic to the pot and cook until the onion is translucent.",
    "Add the carrots and potatoes to the pot and cook for 5 minutes.",
    "Pour in the chicken broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer the stew for 20 minutes or until the vegetables are tender.",
    "Season the stew with salt and black pepper to taste.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
