{
  "title": "Warm Sweet Egyptian Brussels Sprouts Tagine",
  "description": "A sweet and energizing Egyptian dish featuring Brussels sprouts, with a glassy-jelly texture, perfect for a diabetic-friendly meal.",
  "cuisine": "Egyptian",
