      "name": "Brussels sprouts",
      "amount": "1 pound",
      "notes": "trimmed and halved"
    },
    {
      "name": "Olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "Pomegranate molasses",
      "amount": "2 tablespoons"
    },
    {
      "name": "Lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "Sodium alginate",
      "amount": "1 teaspoon"
    },
    {
      "name": "Water",
      "amount": "2 cups"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the halved Brussels sprouts and cook until they start to brown, about 5 minutes.",
    "In a small bowl, whisk together the pomegranate molasses, lemon juice, and sodium alginate.",
    "Add the molasses mixture to the saucepan and stir to combine.",
    "Add the water to the saucepan and bring to a boil.",
    "Reduce the heat to low and simmer, covered, until the Brussels sprouts are tender, about 20 minutes.",
    "Season with salt and black pepper to taste.",
    "Serve the tagine hot, garnished with fresh herbs if desired."
  ],
