{
  "title": "Warmly Spiced Tunisian Chickpea Tagine",
  "description": "A flexitarian friendly Tunisian dish featuring fermented chickpeas and massaman curry paste, perfect for a sick day",
  "cuisine": "Tunisian",
  "diet": [
