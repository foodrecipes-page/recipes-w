    {
      "name": "chickpeas",
      "amount": "1 cup",
      "notes": "fermented overnight"
    },
    {
      "name": "massaman curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and grated"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "finely chopped"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in the bottom of a bamboo steamer over medium heat",
    "Add the chopped onion and cook until translucent",
    "Add the minced garlic and cook for an additional minute",
    "Add the grated carrots and chopped celery and cook until they start to soften",
    "Stir in the massaman curry paste and cook for 1 minute",
    "Add the fermented chickpeas, vegetable broth, salt, and black pepper to the steamer",
    "Bring the mixture to a boil, then reduce the heat to low and steam, covered, for 20 minutes",
    "Serve the tagine hot, garnished with fresh herbs if desired"
  ],
