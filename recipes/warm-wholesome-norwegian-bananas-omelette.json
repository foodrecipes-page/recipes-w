      "notes": "Fresh from the fridge"
    },
    {
      "name": "Bananas",
      "amount": "1",
      "notes": "Ripe, sliced"
    },
    {
      "name": "Yuzu Juice",
      "amount": "2 tablespoons",
      "notes": "Freshly squeezed or bottled"
    },
    {
      "name": "Unsalted Butter",
      "amount": "1 tablespoon",
      "notes": "Softened"
    },
    {
      "name": "All-purpose Flour",
      "amount": "1 tablespoon",
      "notes": "For dusting the claypot"
    },
    {
      "name": "Salt",
      "amount": "1/4 teaspoon",
      "notes": "Flaky sea salt or regular"
    },
    {
      "name": "Fresh Cilantro",
      "amount": "1/4 cup",
      "notes": "Chopped, for garnish"
    },
    {
      "name": "Yuzu Zest",
      "amount": "1/2 teaspoon",
      "notes": "For garnish"
    }
  ],
  "instructions": [
    "Dust the claypot with flour for easy omelette release.",
    "In a bowl, whisk the eggs, salt, and a pinch of yuzu zest until well combined.",
    "Heat the butter in the claypot over medium heat until it's melted and foamy.",
    "Pour the egg mixture into the claypot and let it cook for 30 seconds.",
    "Sprinkle sliced bananas onto half of the omelette.",
    "Drizzle yuzu juice over the bananas and fold the other half of the omelette over the filling.",
    "Cook for another minute until the eggs are almost set.",
    "Use a spatula to carefully slide the omelette out of the claypot onto a plate.",
    "Garnish with chopped cilantro and yuzu zest.",
    "Serve immediately and enjoy the warm, comforting Norwegian Bananas Omelette!"
  ],
