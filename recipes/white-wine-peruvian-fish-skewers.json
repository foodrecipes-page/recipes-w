  "ingredients": [
    {
      "name": "fish fillets",
      "amount": "1 pound",
      "notes": "any white fish works well"
    },
    {
      "name": "white wine",
      "amount": "1/2 cup"
    },
    {
      "name": "lime juice",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cedar planks",
      "amount": "4",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together white wine, lime juice, garlic, and ginger.",
    "Add the fish fillets to the bowl and marinate for 10 minutes.",
    "Remove the fish from the marinade and thread onto skewers.",
    "Brush the cedar planks with olive oil and season with salt and pepper.",
    "Place the skewers on the cedar planks and cook for 8-10 minutes per side.",
    "Cook the fish to an internal temperature of 145 degrees.",
    "Serve the fish hot, garnished with fresh herbs if desired."
  ],
