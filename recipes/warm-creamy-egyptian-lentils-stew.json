{
  "title": "Warm Creamy Egyptian Lentils Stew",
  "description": "A rich and indulgent Egyptian dish featuring red lentils in a creamy vegetable broth, perfect for a cold winter's night.",
  "cuisine": "Egyptian",
  "diet": [
    "sugar-free",
