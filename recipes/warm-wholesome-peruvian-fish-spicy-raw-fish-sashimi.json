  "instructions": [
    "preheat robata grill to medium-high heat.",
    "season the salmon fillet with salt and black pepper.",
    "grill the salmon for 2-3 minutes per side, or until cooked through.",
    "let the salmon rest for 2 minutes before slicing it into thin pieces.",
    "in a blender or food processor, combine amazake, aji amarillo pepper, red onion, chili pepper, garlic, and cilantro.",
    "blend the mixture until smooth, then transfer it to a bowl.",
    "whisk in lime juice, soy sauce, and olive oil.",
    "taste and adjust the seasoning as needed.",
    "arrange the grilled salmon on a plate or cutting board.",
    "drizzle the amazake sauce over the salmon.",
    "serve immediately and enjoy."
  ],
