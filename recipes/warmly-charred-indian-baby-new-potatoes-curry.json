      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat oil in a wok over medium-high heat",
    "Add the chopped onion and cook until it starts to brown",
    "Add the grated ginger and minced garlic and cook for 1 minute",
    "Add the halved baby new potatoes and cook until they are charred on all sides",
    "Add the curry powder, turmeric, cumin, and salt, and stir to combine",
    "Pour in the water and bring the mixture to a simmer",
    "Reduce the heat to medium-low and cook, covered, until the potatoes are tender",
    "Serve the curry hot, garnished with fresh cilantro if desired"
  ],
