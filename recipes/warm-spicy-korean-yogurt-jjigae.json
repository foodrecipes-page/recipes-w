      "notes": "for serving"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "In a blender or food processor, combine yogurt, shio-koji, gochujang, gochugaru, garlic, and ginger, and blend until smooth.",
    "Heat the blended mixture in a ceramic tagine over medium heat, stirring constantly.",
    "Bring the mixture to a simmer and cook for 5 minutes, or until it has thickened slightly.",
    "Add the diced tofu and cook for an additional 2-3 minutes, or until the tofu is heated through.",
    "Stir in the chopped scallions and cook for 1 minute.",
    "Season the jjigae with salt to taste.",
    "Serve the Warm Spicy Korean Yogurt Jjigae hot, drizzled with sesame oil.",
    "Garnish with additional scallions and serve immediately."
  ],
