      "name": "berbere spice",
      "amount": "2 tablespoons"
    },
    {
      "name": "bicarbonate of soda",
      "amount": "1 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "water",
      "amount": "4 cups"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat",
    "Add the onion and cook until softened, about 5 minutes",
    "Add the garlic and ginger and cook for 1 minute",
    "Stir in the berbere spice and cook for 1 minute",
    "Add the lentils, bicarbonate of soda, salt, and water, and bring to a boil",
    "Reduce the heat to low and simmer, covered, for 30 minutes",
    "Uncover and simmer for an additional 10 minutes, or until the lentils are tender",
    "Serve the stew hot, garnished with chopped fresh herbs if desired"
  ],
