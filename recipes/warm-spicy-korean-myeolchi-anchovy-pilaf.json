{
  "title": "Warm Spicy Korean Myeolchi Anchovy Pilaf",
  "description": "A low-glycemic pilaf featuring myeolchi anchovies and shio-koji cure, served on a slate tile vessel.",
  "cuisine": "Korean",
  "diet": [
    "low-glycemic",
    "gluten-free"
  ],
