  "ingredients": [
    {
      "name": "myeolchi anchovies",
      "amount": "1 cup",
      "notes": "dried and rinsed"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons",
      "notes": "Japanese fermented rice seasoning"
    },
    {
      "name": "brown rice",
      "amount": "2 cups",
      "notes": "cooked and cooled"
    },
    {
      "name": "gochujang",
      "amount": "1 tablespoon",
      "notes": "Korean chili paste"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "toasted sesame seeds",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat the sesame oil over medium heat.",
    "Add the myeolchi anchovies and cook for 2 minutes, stirring frequently.",
    "Add the shio-koji, gochujang, and soy sauce, and stir to combine.",
    "Add the cooked brown rice to the skillet and stir to combine with the anchovy mixture.",
    "Transfer the pilaf to a slate tile vessel and top with green onions and toasted sesame seeds.",
    "Bake the pilaf in the preheated oven for 10 minutes, or until warmed through.",
    "Remove the pilaf from the oven and serve immediately."
  ],
