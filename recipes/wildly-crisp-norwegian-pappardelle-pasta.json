{
  "title": "Wildly Crisp Norwegian Pappardelle Pasta",
  "description": "A sour, crisp, and energizing Norwegian dish featuring pappardelle pasta and double-rise-bread, perfect for a flexitarian-friendly meal.",
  "cuisine": "Norwegian",
