    {
      "name": "Chinese broccoli",
      "amount": "1 bunch",
      "notes": "also known as gai lan"
    },
    {
      "name": "Jamaican curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "Scotch bonnet peppers",
      "amount": "2",
      "notes": "use gloves when handling"
    },
    {
      "name": "Onion",
      "amount": "1 medium"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves"
    },
    {
      "name": "Ginger",
      "amount": "1 inch piece"
    },
    {
      "name": "Coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Cure",
      "amount": "1 teaspoon",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large skillet over medium heat.",
    "Add the onion and cook until softened, about 3 minutes.",
    "Add the garlic and ginger and cook for 1 minute, stirring constantly.",
    "Add the Scotch bonnet peppers and cook for 1 minute, stirring constantly.",
    "Add the Chinese broccoli and cook until tender, about 5 minutes.",
    "Add the Jamaican curry powder, salt, and black pepper, and stir to combine.",
    "Add the cure, if using, and stir to combine.",
    "Reduce heat to low and simmer for 2 minutes.",
    "Serve hot and enjoy."
  ],
