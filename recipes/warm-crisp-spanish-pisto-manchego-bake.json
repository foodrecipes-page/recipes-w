{
  "title": "Warm Crisp Spanish Pisto Manchego Bake",
  "description": "A lazy Sunday dish that brings together the flavors of Spain and Italy in a warm, crispy bake.",
  "cuisine": "Spanish",
  "diet": [
    "low-sodium"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "1 large red bell pepper",
      "amount": "1",
      "notes": "seeded and chopped"
    },
    {
      "name": "2 large eggplants",
      "amount": "1",
      "notes": "seeded and chopped"
    },
    {
      "name": "4 ounces Manchego cheese",
      "amount": "1",
      "notes": "shredded"
    },
    {
      "name": "1 can (14.5 oz) diced tomatoes",
      "amount": "1",
      "notes": "drained"
    },
    {
      "name": "1/4 cup olive oil",
      "amount": "1/4",
      "notes": ""
    },
    {
      "name": "4 cloves garlic",
      "amount": "4",
      "notes": "minced"
    },
    {
      "name": "2 teaspoons Italian seasoning",
      "amount": "2",
      "notes": "dried"
    },
    {
      "name": "1/2 teaspoon salt",
      "amount": "1/2",
      "notes": "low-sodium"
    },
    {
      "name": "1/4 teaspoon black pepper",
      "amount": "1/4",
      "notes": ""
    },
    {
      "name": "1 cup bread crumbs",
      "amount": "1",
      "notes": ""
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "In a large skillet, heat the olive oil over medium heat. Add the garlic and cook until fragrant, 1-2 minutes.",
    "Add the chopped bell pepper and eggplant to the skillet, cooking until tender, about 5 minutes.",
    "Stir in the diced tomatoes, Italian seasoning, salt, and pepper. Cook for an additional 2-3 minutes.",
    "In a large baking dish, arrange half of the bread crumbs on the bottom.",
    "Add the cooked vegetable mixture on top of the bread crumbs.",
    "Sprinkle the shredded Manchego cheese over the vegetable mixture.",
    "Top with the remaining bread crumbs.",
    "Bake for 25-30 minutes or until the top is golden brown and the cheese is melted.",
    "Remove from the oven and let it rest for 5-10 minutes before serving."
  ],
