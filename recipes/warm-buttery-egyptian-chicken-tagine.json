  "ingredients": [
    {
      "name": "chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "boneless, skinless"
    },
    {
      "name": "hojicha tea",
      "amount": "2 tablespoons",
      "notes": "loose leaf"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup"
    },
    {
      "name": "mother sauce",
      "amount": "1 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "fresh, grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit",
    "Steep the hojicha tea in 2 tablespoons of hot water for 5 minutes",
    "Melt the butter in a large Dutch oven over medium heat",
    "Add the garlic, ginger, cumin, paprika, salt, and pepper to the pot and cook for 1 minute",
    "Add the chicken to the pot and cook until browned on all sides",
    "Add the mother sauce and steeped hojicha tea to the pot and stir to combine",
    "Cover the pot and transfer it to the preheated oven",
    "Bake for 30 minutes or until the chicken is cooked through",
    "Serve the chicken and sauce hot, garnished with fresh herbs if desired"
  ],
