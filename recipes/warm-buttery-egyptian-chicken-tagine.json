{
  "title": "Warm Buttery Egyptian Chicken Tagine",
  "description": "A rich and aromatic Egyptian dish featuring chicken cooked in a buttery hojicha sauce, perfect for a romantic dinner",
  "cuisine": "Egyptian",
  "diet": [
    "halal"
  ],
