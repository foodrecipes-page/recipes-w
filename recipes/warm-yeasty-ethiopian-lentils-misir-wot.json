  "ingredients": [
    {
      "name": "red lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "beer",
      "amount": "1/2 cup",
      "notes": "any type, for yeasty flavor"
    },
    {
      "name": "dum",
      "amount": "2 tablespoons",
      "notes": "or berbere spice mix"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large cast-iron skillet over medium heat.",
    "Add the onion and cook until it is softened and lightly browned.",
    "Add the garlic and ginger and cook for 1 minute, stirring constantly.",
    "Add the lentils, beer, dum, salt, and pepper, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 30 minutes, or until the lentils are tender.",
    "Mash the lentils slightly with a spoon to create a thick and velvety texture.",
    "Serve the misir wot hot, garnished with chopped fresh cilantro or scallions, if desired."
  ],
