      "notes": "Indian cheese"
    },
    {
      "name": "nduja",
      "amount": "2 tbsp",
      "notes": "spicy sausage paste"
    },
    {
      "name": "palak puree",
      "amount": "1 cup",
      "notes": "spinach puree"
    },
    {
      "name": "malt extract",
      "amount": "1 tsp",
      "notes": "malty flavor"
    },
    {
      "name": "garam masala",
      "amount": "1 tsp",
      "notes": "Indian spice blend"
    },
    {
      "name": "low-fat cream",
      "amount": "1/2 cup",
      "notes": "for emulsification"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    },
    {
      "name": "fresh cilantro",
      "amount": "chopped, for garnish"
    }
  ],
  "instructions": [
    "Heat the nduja in a large pan over medium heat until fragrant.",
    "Add the malt extract and garam masala and cook for 1 minute.",
    "Add the palak puree and cook until heated through.",
    "Add the paneer and cook until the cheese is coated in the spinach mixture.",
    "In a small bowl, whisk together the low-fat cream and a pinch of salt and pepper.",
    "Pour the cream mixture into the pan and stir to emulsify.",
    "Reduce heat to low and simmer for 5 minutes.",
    "Season with salt and black pepper to taste.",
    "Garnish with chopped fresh cilantro and serve hot."
  ],
