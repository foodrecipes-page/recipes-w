    {
      "name": "Rice, khao khua",
      "amount": "2 cups",
      "notes": "Day-old fried rice"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "Minced"
    },
    {
      "name": "Ghee or oil",
      "amount": "2 tablespoons",
      "notes": "For pan-frying"
    },
    {
      "name": "Cheddar cheese",
      "amount": "1 cup",
      "notes": "Grated"
    },
    {
