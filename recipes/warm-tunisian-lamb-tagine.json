{
  "title": "Warm Tunisian Lamb Tagine",
  "description": "A rich and flavorful Tunisian dish featuring lamb, dark chocolate, and spices, perfect for a special occasion",
  "cuisine": "Tunisian",
  "diet": [
    "gluten-free",
