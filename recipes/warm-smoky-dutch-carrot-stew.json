{
  "title": "Warm Smoky Dutch Carrot Stew",
  "description": "A hearty and aromatic stew featuring smoky Jamaican curry powder and katsuramuki-cut carrots, perfect for a cozy evening meal. This dish is Buddhist-temple-friendly and free from animal products.",
  "cuisine": "Dutch",
  "diet": [
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "carrots",
      "amount": "1 pound",
      "notes": "katsuramuki-cut"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Jamaican curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "canned coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the katsuramuki-cut carrots and cook for an additional 5 minutes.",
    "Stir in the Jamaican curry powder and smoked paprika and cook for 1 minute.",
    "Pour in the vegetable broth and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes.",
    "Stir in the canned coconut milk and cook for an additional 5 minutes.",
    "Season with salt and black pepper to taste.",
    "Garnish with chopped fresh parsley and serve hot."
  ],
