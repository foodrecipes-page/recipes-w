      "amount": "1/4 teaspoon"
    },
    {
      "name": "ground cinnamon",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cardamom powder",
      "amount": "1/8 teaspoon"
    },
    {
      "name": "saffron threads",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "large egg",
      "amount": "1"
    },
    {
      "name": "plain Greek yogurt",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped pistachios",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "In a small bowl, mix together honey, ginger, cinnamon, cardamom powder, and saffron threads.",
    "In a medium bowl, whisk together semolina flour and egg until well combined.",
    "Add yogurt to the semolina mixture and mix until smooth.",
    "Add the honey-spice mixture to the semolina mixture and mix until well combined.",
    "Pour the semolina mixture into a scallop shell or a heatproof bowl.",
    "Dot the top of the semolina mixture with unsalted butter.",
    "Bake for 20 minutes or until the top is golden brown and the semolina is set.",
    "Remove from oven and sprinkle with chopped pistachios.",
    "Serve warm."
  ],
