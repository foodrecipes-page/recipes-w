      "name": "long fermentation dough",
      "amount": "1 pound",
      "notes": "homemade or store bought"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "panang paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "carrots",
      "amount": "1 cup",
      "notes": "peeled and grated"
    },
    {
      "name": "zucchini",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "red bell pepper",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "onion",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "mozzarella cheese",
      "amount": "1/2 cup",
      "notes": "shredded"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Roll out the long fermentation dough to a thickness of 1/4 inch",
    "Transfer the dough to a baking sheet lined with parchment paper",
    "Spread the panang paste evenly over the dough, leaving a 1 inch border around the edges",
    "Top the panang paste with the grated carrots, sliced zucchini, sliced red bell pepper, and thinly sliced onion",
    "Sprinkle the shredded mozzarella cheese over the vegetables",
    "Dot the top of the flatbread with the unsalted butter",
    "Season with salt and pepper to taste",
    "Bake the flatbread in the preheated oven for 25 minutes, or until the crust is golden brown and the cheese is melted and bubbly"
  ],
