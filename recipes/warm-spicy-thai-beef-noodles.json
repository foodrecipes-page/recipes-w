{
  "title": "Warm Spicy Thai Beef Noodles",
  "description": "A sour and spicy Thai dish featuring hot beef stock and served in a stone bowl, this meal is perfect for a weeknight dinner and is ayurvedic-sattvic-friendly.",
  "cuisine": "Thai",
  "diet": [
    "gluten-free",
    "dairy-free"
