  "ingredients": [
    {
      "name": "beef stock",
      "amount": "4 cups",
      "notes": "homemade or store-bought"
    },
    {
      "name": "rice noodles",
      "amount": "8 oz"
    },
    {
      "name": "grilled beef",
      "amount": "1 lb",
      "notes": "sliced into thin strips"
    },
    {
      "name": "Thai red curry paste",
      "amount": "2 tbsp"
    },
    {
      "name": "fish sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "lime juice",
      "amount": "2 tbsp"
    },
    {
      "name": "brown sugar",
      "amount": "1 tsp"
    },
    {
      "name": "Thai basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Bring the beef stock to a boil in a large pot.",
    "Add the rice noodles to the pot and cook for 3-5 minutes or until they are slightly tender.",
    "In a small bowl, mix together the Thai red curry paste, fish sauce, lime juice, and brown sugar.",
    "Add the curry paste mixture to the pot and stir to combine.",
    "Add the sliced grilled beef to the pot and cook for an additional 2-3 minutes or until the beef is heated through.",
    "Stir in the chopped Thai basil.",
    "Serve the noodles and beef in a stone bowl.",
    "Garnish with additional Thai basil if desired."
  ],
