{
  "title": "Warm Smoky Chinese Pork Skewers",
  "description": "A romantic Chinese dish featuring smoky and crispy pork skewers with parsley, inspired by Yunnan cuisine, and prepared with anti-inflammatory friendly ingredients.",
  "cuisine": "Chinese",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "honey",
      "amount": "1 tablespoon"
    },
    {
      "name": "rice vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "smoked paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together soy sauce, honey, rice vinegar, sesame oil, garlic, and ginger.",
    "Add the pork pieces to the bowl and toss to coat with the marinade.",
    "Thread the marinated pork pieces onto skewers, leaving a small space between each piece.",
    "Brush the skewers with the marinade and sprinkle with smoked paprika.",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the pork is cooked through and slightly charred.",
    "Garnish with chopped parsley and serve immediately."
  ],
