      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "green salsa",
      "amount": "1 cup"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat a comal or grill to 400 degrees Fahrenheit",
    "In a large bowl whisk together olive oil, garlic, paprika, salt, and black pepper",
    "Add the chicken to the bowl and toss to coat evenly",
    "Thread the chicken onto skewers",
    "Place the skewers on the comal and cook for 10 minutes per side",
    "While the chicken is cooking heat the green salsa in a small saucepan over low heat",
    "Once the chicken is cooked serve with the warm green salsa and garnish with parsley",
    "Serve immediately and enjoy"
  ],
