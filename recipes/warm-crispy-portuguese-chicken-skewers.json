{
  "title": "Warm Crispy Portuguese Chicken Skewers",
  "description": "A romantic Portuguese dish featuring crispy chicken skewers served with a side of green salsa, perfect for a low carb dinner",
  "cuisine": "Portuguese",
  "diet": [
    "low-carb",
    "gluten-free"
  ],
