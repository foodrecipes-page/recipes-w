      "amount": "12 sheets"
    },
    {
      "name": "shredded carrots",
      "amount": "1 cup"
    },
    {
      "name": "shredded zucchini",
      "amount": "1 cup"
    },
    {
      "name": "chopped scallions",
      "amount": "1/2 cup"
    },
    {
      "name": "toasted sesame seeds",
      "amount": "2 tablespoons"
    },
    {
      "name": "ayurvedic tamasic spices",
      "amount": "1 teaspoon",
      "notes": "such as cumin and coriander"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large skillet over medium heat",
    "Add the shredded carrots and zucchini and cook until tender",
    "Add the chopped scallions and ayurvedic tamasic spices and cook for 1 minute",
    "Layout the spring roll wrappers and fill with the carrot and zucchini mixture",
    "Drizzle the sesame butter and tempering chocolate over the filling",
    "Sprinkle the toasted sesame seeds over the top",
    "Roll up the spring rolls tightly and slice in half",
    "Serve warm and enjoy"
  ],
