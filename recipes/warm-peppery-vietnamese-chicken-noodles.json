      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "grated ginger",
      "amount": "1 tablespoon"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat 1 tablespoon of oil in a clay pot over medium heat",
    "Add the chicken to the pot and cook until browned, about 5 minutes",
    "Add the grated ginger, garlic, and black pepper to the pot and cook for 1 minute",
    "Add the fish sauce and soy sauce to the pot and stir to combine",
    "Add the farfalle noodles to the pot and stir to combine with the chicken and sauce",
    "Cook for an additional 5 minutes, or until the noodles are tender",
    "Stir in the chopped scallions and cook for 1 minute",
    "Serve the noodles hot, garnished with additional scallions if desired"
  ],
