{
  "title": "Warm Roasted Wholesome Carrot Wrap",
  "description": "This quick-fix Japanese dish features earthy roasted carrots with a creamy dressing and a touch of rosemary. It's perfect for a diabetic-friendly breakfast or snack.",
  "cuisine": "Japanese",
  "diet": [
    null,
    "diabetic-friendly"
  ],
