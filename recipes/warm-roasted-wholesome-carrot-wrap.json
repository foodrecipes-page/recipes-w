  "ingredients": [
    {
      "name": "Carrots",
      "amount": 4
    },
    {
      "name": "All-purpose flour",
      "amount": "2 tbsp"
    },
    {
      "name": "Water",
      "amount": "1/4 cup"
    },
    {
      "name": "Tamari sauce",
      "amount": "1 tbsp"
    },
    {
      "name": "Coconut oil",
      "amount": "2 tbsp"
    },
    {
      "name": "Dijon mustard",
      "amount": "1 tsp"
    },
    {
      "name": "Apple cider vinegar",
      "amount": "1 tsp"
    },
    {
      "name": "Fresh rosemary sprigs",
      "amount": "6-8"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "Slice carrots into rounds, about 1/4 inch thick.",
    "In a bowl, mix flour and water to form a dough. Knead briefly until smooth.",
    "Roll out dough on a floured surface. Cut into strips for wraps.",
    "Fry carrot slices in coconut oil until golden brown, about 3-5 minutes per side.",
    "Mix tamari, dijon mustard, and apple cider vinegar to make the dressing.",
    "Toss fried carrots with dressing. Top each wrap with a few rosemary sprigs before serving warm.",
    "Serve immediately."
  ],
