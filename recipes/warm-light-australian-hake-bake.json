      "name": "hake fillets",
      "amount": "4 pieces",
      "notes": "fresh or frozen, thawed"
    },
    {
      "name": "score-fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Line a baking sheet with parchment paper.",
    "Place the hake fillets on the prepared baking sheet.",
    "Drizzle the score-fat, lemon juice, and olive oil over the hake fillets.",
    "Sprinkle the garlic, thyme, salt, and pepper over the top of each fillet.",
    "Bake the hake for 12 minutes or until cooked through.",
    "Remove the hake from the oven and let it rest for 2 minutes.",
    "Serve the hake hot, garnished with lemon wedges if desired."
  ],
