{
  "title": "Warm Light Australian Hake Bake",
  "description": "A light and umami-rich Australian dish featuring hake, perfect for a sick day, and suitable for diabetic diets. This recipe uses score-fat for added flavor.",
  "cuisine": "Australian",
  "diet": [
    "diabetic-friendly",
