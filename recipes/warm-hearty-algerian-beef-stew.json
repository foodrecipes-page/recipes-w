{
  "title": "Warm Hearty Algerian Beef Stew",
  "description": "A pungent and shaggy Algerian dish featuring beef stock and long fermentation dough, perfect for a cold evening",
  "cuisine": "Algerian",
  "diet": [
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "beef stock",
      "amount": "4 cups",
      "notes": "homemade or store bought"
    },
    {
      "name": "long fermentation dough",
      "amount": "1 cup",
      "notes": "crushed into small pieces"
    },
    {
      "name": "beef chunks",
      "amount": "2 pounds"
    },
    {
      "name": "onion",
      "amount": "2 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "carrots",
      "amount": "4 medium"
    },
    {
      "name": "potatoes",
      "amount": "4 medium"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large kazan cauldron over medium heat",
    "Add the beef chunks and cook until browned on all sides",
    "Add the onion and garlic and cook until the onion is translucent",
    "Add the carrots and potatoes and cook for 5 minutes",
    "Add the beef stock and bring to a boil",
    "Reduce the heat to low and simmer for 1 hour",
    "Add the crushed long fermentation dough and cook for an additional 30 minutes",
    "Season with salt and black pepper to taste",
    "Serve hot in the kazan cauldron"
  ],
