{
  "title": "Warm Smoky Thai Tofu Skewers",
  "description": "Smoky and light Thai-inspired skewers featuring holy basil and grilled to perfection, perfect for a brunch mood polish dish, jain-friendly and delicious",
  "cuisine": "Thai",
  "diet": [
    "vegetarian",
    "vegan",
    "jain"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "Extra firm tofu",
      "amount": "1 block",
      "notes": "drained and cut into 1 inch cubes"
    },
    {
      "name": "Thai holy basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "Lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "Soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "Brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "Smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Bamboo skewers",
      "amount": "10-12",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the yakimono grill to medium high heat",
    "In a large bowl, whisk together coconut milk, lime juice, soy sauce, brown sugar, smoked paprika, salt, and pepper",
    "Add the chopped holy basil to the bowl and stir to combine",
    "Add the cubed tofu to the bowl and toss to coat with the marinade",
    "Thread the marinated tofu onto the soaked bamboo skewers",
    "Grill the skewers for 8-10 minutes, turning occasionally",
    "Serve the skewers warm, garnished with additional holy basil if desired",
    "Repeat with remaining ingredients",
    "Serve immediately and enjoy"
  ],
