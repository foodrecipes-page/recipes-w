  "instructions": [
    "Heat the coconut oil in a large pan over medium heat",
    "Add the diced onion and cook until softened",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the curry powder and cook for 1 minute",
    "Add the oysters and cook until they start to open",
    "Pour in the coconut milk and bring to a simmer",
    "Add the fish sauce and lime juice and stir to combine",
    "Season with salt to taste",
    "Reduce the heat to low and let simmer for 5 minutes"
  ],
