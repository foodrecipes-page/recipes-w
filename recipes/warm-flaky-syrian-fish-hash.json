      "amount": "1/4 cup",
      "notes": "For frying"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "Finely chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "Minced"
    },
    {
      "name": "Spices (cumin, coriander, paprika)",
      "amount": "2 teaspoons",
      "notes": "Blended"
    },
    {
      "name": "Flour",
      "amount": "1 cup",
      "notes": "All-purpose flour"
    },
    {
