      "amount": "2 tablespoons",
      "notes": "Unsalted"
    },
    {
      "name": "Eggs",
      "amount": "2 large",
      "notes": "Beaten"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon",
      "notes": "For garnish"
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "Chopped"
    }
  ],
  "instructions": [
    "Heat 2 tablespoons of ground nut oil in a large pan over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the blended spices and cook for 1 minute.",
    "Add the finely chopped fish and cook until it breaks apart, about 5 minutes.",
    "Add the all-purpose flour and cook for 1 minute.",
    "Gradually add the beaten eggs and mix well.",
    "Season with salt to taste.",
    "Transfer the mixture to a greased pan and flatten it.",
    "Drizzle the remaining 2 tablespoons of ground nut oil on top.",
    "Bake in a preheated oven at 375°F (190°C) for 20 minutes.",
    "Remove from the oven and garnish with chopped parsley."
  ],
