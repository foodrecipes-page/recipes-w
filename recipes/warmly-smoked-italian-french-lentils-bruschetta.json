{
  "title": "Warmly Smoked Italian French Lentils Bruschetta",
  "description": "A lazy Sunday Italian dish featuring French lentils, binchotan-charcoal smoked flavor, and a low-calorie friendly twist, all on toasted bruschetta.",
  "cuisine": "Italian",
  "diet": [
    "low-calorie",
    "vegetarian"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "French lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "binchotan charcoal",
      "amount": "1 piece",
      "notes": "for smoking"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "canned diced tomatoes",
      "amount": "1 cup"
    },
    {
      "name": "italian seasoning",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "whole wheat bread",
      "amount": "4 slices"
    },
    {
      "name": "fresh basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Smoke the French lentils using binchotan charcoal for 10 minutes.",
    "In a large saucepan, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional 1 minute.",
    "Add the smoked lentils, canned diced tomatoes, italian seasoning, salt, and black pepper to the saucepan.",
    "Stir to combine and bring to a simmer.",
    "Reduce heat to low and let cook for 20 minutes, stirring occasionally.",
    "Meanwhile, toast the whole wheat bread slices in the oven for 5 minutes.",
    "Top the toasted bread with the lentil mixture and chopped fresh basil."
  ],
