{
  "title": "Warm Buttery Tunisian Pak Choi Skillet",
  "description": "A quick and delicious Tunisian dish featuring pak choi, pickle, and a blend of aromatic spices, all in a warm and buttery skillet.",
  "cuisine": "Tunisian",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "pak choi",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "vegan butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "pickle",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "tunisian spice blend",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the vegan butter in a large skillet over medium heat.",
    "Add the chopped garlic and cook for 1 minute until fragrant.",
    "Add the chopped pak choi and cook for 2 minutes until it starts to wilt.",
    "Add the chopped pickle, tunisian spice blend, salt, and black pepper, and stir to combine.",
    "Cook for an additional 2 minutes until the pak choi is tender.",
    "Squeeze the lemon juice over the top and stir to combine.",
    "Serve hot and enjoy.",
    "Garnish with additional lemon wedges if desired."
  ],
