      "amount": "1 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "Galangal",
      "amount": "1 tsp"
    },
    {
      "name": "Garlic",
      "amount": "1 clove"
    }
  ],
  "instructions": [
    "Preheat a hot stone plate to 400°F.",
    "In a bowl, mix together the fermented fish sauce, coconut oil, egg, salt, black pepper, galangal, and garlic.",
    "Add the Thai flatbread to the bowl and toss to combine.",
    "Transfer the mixture to the preheated stone plate.",
    "Bake for 10 minutes, or until the crust is golden brown.",
    "Remove from heat and sprinkle with parmesan cheese.",
    "Bake for an additional 2-3 minutes, or until the cheese is melted and bubbly."
  ],
