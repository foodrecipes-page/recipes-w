      "name": "deodeok root",
      "amount": "1 pound",
      "notes": "peeled and cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "thyme",
      "amount": "1 tablespoon",
      "notes": "fresh"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "sodium alginate",
      "amount": "1 teaspoon"
    },
    {
      "name": "water",
      "amount": "1 cup"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Thread the deodeok root pieces onto skewers.",
    "In a bowl, mix together olive oil, garlic, thyme, lemon juice, salt, and pepper.",
    "Brush the mixture onto the deodeok root skewers.",
    "In a separate bowl, mix together sodium alginate and water.",
    "Spherify the deodeok root pieces by dropping them into the alginate bath.",
    "Remove the spherified deodeok root from the bath with a slotted spoon.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Sprinkle paprika over the skewers.",
    "Bake for 20 minutes or until crunchy."
  ],
