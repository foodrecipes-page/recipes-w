{
  "title": "Wonderful Crunchy Basque French Deodeok Root Skewers",
  "description": "A herbal and crunchy crowd-pleaser dish featuring deodeok root, with a Basque French twist, dairy-free friendly and spherified for added fun.",
  "cuisine": "Basque French",
  "diet": [
    "dairy-free",
