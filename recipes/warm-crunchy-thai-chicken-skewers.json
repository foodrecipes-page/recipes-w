    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat",
    "In a large bowl, whisk together fish sauce, lime juice, brown sugar, garlic, and ginger",
    "Add the chicken to the bowl and toss to coat",
    "Thread the chicken onto skewers",
    "Brush the skewers with sesame oil",
    "Grill the skewers for 8-10 minutes, or until charred and cooked through",
    "While the skewers are grilling, melt the unsalted butter in a small saucepan over medium heat",
    "Once the skewers are done, brush them with the melted butter",
    "Serve the skewers hot, garnished with chopped cilantro and lime wedges"
  ],
