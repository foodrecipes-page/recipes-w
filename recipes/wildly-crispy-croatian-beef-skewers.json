{
  "title": "Wildly Crispy Croatian Beef Skewers",
  "description": "A sour and snappy Croatian dish featuring mixed beef cuts, deep-fried to perfection, served on a tagliere",
  "cuisine": "Croatian",
  "diet": [
    "gluten-free",
