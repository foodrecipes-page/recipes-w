      "name": "beef sirloin",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "beef brisket",
      "amount": "1/2 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "all-purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "cornstarch",
      "amount": "1/2 cup"
    },
    {
      "name": "paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "In a large bowl, whisk together flour, cornstarch, paprika, garlic powder, salt, and black pepper",
    "Add the beef pieces to the bowl and toss to coat evenly",
    "Heat the vegetable oil in a deep frying pan to 350 degrees Fahrenheit",
    "Using a slotted spoon, carefully add the beef pieces to the hot oil",
    "Fry the beef for 5-6 minutes, or until golden brown and crispy",
    "Remove the beef from the oil with a slotted spoon and place on a paper towel-lined plate to drain excess oil",
    "Thread the fried beef pieces onto skewers",
    "Serve the skewers on a tagliere and enjoy"
  ],
