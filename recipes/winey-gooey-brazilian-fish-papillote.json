  "ingredients": [
    {
      "name": "cod fish",
      "amount": "4 fillets",
      "notes": "fresh and skin removed"
    },
    {
      "name": "white wine",
      "amount": "1 cup",
      "notes": "dry"
    },
    {
      "name": "lemon juice",
      "amount": "1/2 cup",
      "notes": "freshly squeezed"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "extra virgin"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "papillote paper",
      "amount": "4 sheets",
      "notes": "or parchment paper"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees.",
    "In a large bowl, whisk together the white wine, lemon juice, olive oil, garlic, ginger, and turmeric.",
    "Place a cod fillet in the center of each papillote paper sheet.",
    "Brush the wine and lemon juice sauce over the fish, making sure it is fully coated.",
    "Fold the papillote paper over the fish, creating a tight seal.",
    "Place the papillote packets on a baking sheet and bake for 12 minutes.",
    "Remove the packets from the oven and let them rest for 2 minutes.",
    "Serve the fish hot, garnished with fresh parsley or cilantro."
  ],
