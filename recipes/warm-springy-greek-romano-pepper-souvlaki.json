{
  "title": "Warm Springy Greek Romano Pepper Souvlaki",
  "description": "A nutty and springy post-workout Greek dish featuring Romano pepper and ferment-kimchi, made in a tava-griddle and served as souvlaki.",
  "cuisine": "Greek",
  "diet": [
    "vegetarian"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "Romano peppers",
      "amount": "4 large",
      "notes": "any color"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "extra virgin olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pita bread",
      "amount": "4 slices"
    },
    {
      "name": "crumbly feta cheese",
      "amount": "1/2 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat the tava-griddle over medium heat.",
    "Brush the Romano peppers with olive oil and season with salt and black pepper.",
    "Grill the peppers for 5 minutes on each side, until the skin is blistered and charred.",
    "Remove the peppers from the grill and let them cool.",
    "Peel the peppers and slice them into thin strips.",
    "In a small bowl, mix together the ferment-kimchi, garlic, and lemon juice.",
    "Brush the pita bread slices with olive oil and grill for 1 minute on each side.",
    "Assemble the souvlaki by placing a few slices of the grilled pepper on each pita bread slice, followed by a spoonful of the kimchi mixture.",
    "Top with crumbly feta cheese if desired.",
    "Serve immediately and enjoy."
  ],
