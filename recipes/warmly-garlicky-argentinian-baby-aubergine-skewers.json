    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "Thread the baby aubergine onto skewers, leaving a small space between each piece",
    "In a bowl, mix together the minced garlic, bonito flakes, olive oil, lemon juice, salt, and black pepper",
    "Brush the garlic-bonito mixture evenly onto the baby aubergine",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the aubergine is tender and lightly charred",
    "Garnish with chopped fresh parsley",
    "Serve warm and enjoy"
  ],
