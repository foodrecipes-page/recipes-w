  "instructions": [
    "heat the oil in a large paella pan over medium-high heat.",
    "add the beef and cook until browned, about 5 minutes.",
    "remove the beef from the pan and set aside.",
    "add the smoked paprika, cumin, brown sugar, salt, and black pepper to the pan and cook for 1 minute.",
    "add the chicken broth, vinegar, and rum to the pan and bring to a boil.",
    "add the saffron threads and cook for 1 minute.",
    "add the flour and cook for 1 minute.",
    "add the browned beef back to the pan and stir to combine.",
    "add the spherified beef broth and cook for 2 minutes.",
    "sprinkle the cilantro and scallions over the top and serve hot."
