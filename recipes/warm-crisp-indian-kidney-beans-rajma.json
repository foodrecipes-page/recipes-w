      "name": "kidney beans",
      "amount": "1 cup",
      "notes": "canned, drained, and rinsed"
    },
    {
      "name": "all-purpose flour",
      "amount": "2 tablespoons"
    },
    {
      "name": "ghee or oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "ginger",
      "amount": "2 inches",
      "notes": "grated"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the ghee or oil in a clay pot over medium heat.",
    "Add the cumin seeds and let them sizzle for a few seconds.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the grated ginger and minced garlic and cook for another minute.",
    "Add the kidney beans, coriander powder, turmeric powder, and salt, and stir well.",
    "Sprinkle the all-purpose flour over the kidney beans and stir to combine.",
    "Cook for 10-12 minutes, stirring occasionally, until the kidney beans are crispy and golden brown.",
    "Serve hot, garnished with chopped fresh cilantro, if desired."
  ],
