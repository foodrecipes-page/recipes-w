    {
      "name": "bok choi",
      "amount": "1 head",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "pickles",
      "amount": "1/2 cup",
      "notes": "sliced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "oregano",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "feta cheese",
      "amount": "1/4 cup",
      "notes": "crumbled"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat",
    "Add the minced garlic and cook for 1 minute until fragrant",
    "Add the chopped bok choi and cook until wilted",
    "Add the sliced pickles, lemon juice, oregano, salt, and black pepper",
    "Stir well to combine and cook for 5 minutes",
    "Reduce heat to low and stir in the crumbled feta cheese",
    "Cook for an additional 2 minutes until the cheese is melted",
    "Serve hot and enjoy"
  ],
