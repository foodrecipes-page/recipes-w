{
  "title": "Warm Velvety Filipino Peanut Butter Wrap",
  "description": "A kid-friendly Filipino dish featuring peanut butter, boiled to perfection and wrapped in a lotus leaf, this fermented and velvety treat is a delight to eat, it is also low-glycemic-friendly.",
  "cuisine": "Filipino",
  "diet": [
    "low-glycemic",
    "kid-friendly"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "peanut butter",
      "amount": "1/2 cup",
      "notes": "creamy natural peanut butter"
    },
    {
      "name": "lotus leaves",
      "amount": "4 large leaves"
    },
    {
      "name": "brown rice",
      "amount": "1 cup cooked"
    },
    {
      "name": "banana blossoms",
      "amount": "1 cup boiled and chopped"
    },
    {
      "name": "coconut milk",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup chopped"
    }
  ],
  "instructions": [
    "Boil the lotus leaves in water for 30 seconds to make them pliable.",
    "Mix the peanut butter, brown rice, banana blossoms, coconut milk, salt, and black pepper in a bowl.",
    "Add the chopped green onions on top of the peanut butter mixture and stir well.",
    "Lay a boiled lotus leaf flat and place about 1/2 cup of the peanut butter mixture in the center of the leaf.",
    "Fold the stem end over the filling, then fold in the sides and roll the leaf into a tight cylinder.",
    "Repeat with the remaining ingredients.",
    "Serve the wraps warm.",
    "Refrigerate or freeze the leftovers for up to 3 days."
  ],
