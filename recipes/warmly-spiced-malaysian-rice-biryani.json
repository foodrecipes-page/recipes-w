      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Water",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until it is lightly browned.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Stir in the biryani masala and cook for 1 minute.",
    "Add the basmati rice and stir to coat the rice with the spice mixture.",
    "Add the water and salt, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 15 minutes.",
    "Turn off the heat and let it sit for 5 minutes.",
    "Fluff the rice with a fork and serve hot."
  ],
