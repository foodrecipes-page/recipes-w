  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Chop the celery into 1 inch pieces and set aside.",
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the garlic and onion to the skillet and cook until the onion is translucent.",
    "Add the chopped celery to the skillet and cook for an additional 5 minutes.",
    "Stir in the tomato paste, cumin, paprika, salt, and black pepper.",
    "Transfer the mixture to a baking dish and drizzle with lemon juice.",
    "Cover the dish with aluminum foil and bake for 25 minutes.",
    "Remove the foil and continue baking for an additional 10 minutes."
  ],
