  "ingredients": [
    {
      "name": "corn kernels",
      "amount": "1 cup",
      "notes": "fresh or frozen"
    },
    {
      "name": "clotted cream",
      "amount": "1/2 cup",
      "notes": "extra rich"
    },
    {
      "name": "unsalted butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "all purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "milk",
      "amount": "1 cup"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "grated cheddar cheese",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, melt the butter over medium heat.",
    "Add the corn kernels and cook until lightly browned, about 5 minutes.",
    "In a large bowl, whisk together the flour, milk, eggs, salt, and pepper.",
    "Add the clotted cream and whisk until smooth.",
    "Add the cooked corn kernels, grated cheddar cheese, and stir until well combined.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 35-40 minutes, or until the casserole is golden brown and set."
  ],
