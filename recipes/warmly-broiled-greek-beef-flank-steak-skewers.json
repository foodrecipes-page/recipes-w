      "name": "beef flank steak",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    },
    {
      "name": "kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/4 cup",
      "notes": "canned"
    },
    {
      "name": "sun-dried tomatoes",
      "amount": "1/4 cup",
      "notes": "packed in oil"
    },
    {
      "name": "red onion",
      "amount": "1/4 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the broiler to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together lemon juice, olive oil, and garlic powder.",
    "Add the beef flank steak pieces to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated beef, feta cheese, kalamata olives, artichoke hearts, sun-dried tomatoes, and red onion onto skewers.",
    "Place the skewers on a broiler pan lined with aluminum foil and broil for 10-12 minutes, flipping halfway.",
    "Remove the skewers from the oven and sprinkle with chopped parsley.",
    "Serve the skewers hot, garnished with additional parsley if desired.",
    "Let the skewers rest for a few minutes before serving to allow the juices to redistribute."
  ],
