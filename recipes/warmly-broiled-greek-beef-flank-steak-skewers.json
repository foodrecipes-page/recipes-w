{
  "title": "Warmly Broiled Greek Beef Flank Steak Skewers",
  "description": "A kosher-friendly Greek dish featuring beef flank steak, perfect for midnight cravings, with a fermented and cheese-pull twist.",
  "cuisine": "Greek",
  "diet": [],
  "meal": "snack",
  "ingredients": [
