  "instructions": [
    "heat olive oil in the tajine over medium heat.",
    "add minced garlic and sauté until golden, about 3-4 minutes.",
    "add chopped onion and cook until translucent, about 5-6 minutes.",
    "add smoked paprika, salt, and black pepper, stir to combine.",
    "add malt vinegar and stir to combine.",
    "add chopped fresh dill and stir to combine.",
    "add cottage cheese and stir to combine.",
    "add sour cream and stir to combine.",
    "add frozen peas and stir to combine.",
    "reduce heat to low and simmer, covered, for 10-12 minutes.",
    "garnish with chopped scallions and serve."
